{
	"name": "custom-sidebar-icons",
	"version": "2.7.0",
	"description": "Enhance your workspace with customizable icons for documents and folders.",
	"main": "main.js",
	"scripts": {
		"dev": "node --env-file-if-exists=.env scripts/deploy.mjs link && node scripts/esbuild.config.mjs dev",
		"build": "tsc -noEmit -skipLibCheck && node scripts/esbuild.config.mjs prod && node --env-file-if-exists=.env scripts/deploy.mjs copy",
		"lint": "eslint src/",
		"i18n:typesafe": "typesafe-i18n",
		"i18n:sync": "node scripts/sync-i18n.mjs",
		"test": "jest",
		"test:watch": "jest --watch"
	},
	"keywords": [
		"Custom Icons",
		"Obsidian Plugin"
	],
	"author": "RavenHogWarts",
	"license": "GPL-3.0-only",
	"engines": {
		"node": ">=22.x"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@obsidian-typings/obsidian-catalyst-latest": "^6.21.0",
		"@tanstack/react-virtual": "^3.14.10",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.9.1",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"esbuild": "0.28.0",
		"eslint": "^10.4.0",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^17.6.0",
		"jest": "^30.4.2",
		"lucide-react": "^1.21.0",
		"obsidian": "^1.13.1",
		"postcss": "^8.5.15",
		"postcss-nesting": "^14.0.0",
		"radix-ui": "^1.6.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"ts-jest": "^29.4.10",
		"tslib": "2.8.1",
		"typesafe-i18n": "^5.27.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.60.0"
	}
}
